---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Arch Design System</title>
    {description && <meta name="description" content={description} />}
    <style>
      :root {
        --docs-max-width: 72rem;
        --docs-sidebar-width: 16rem;
        --docs-font-sans: system-ui, -apple-system, sans-serif;
        --docs-font-mono: ui-monospace, 'SFMono-Regular', monospace;
      }
      * { margin: 0; box-sizing: border-box; }
      body {
        font-family: var(--docs-font-sans);
        line-height: 1.6;
        color: #1a1a1a;
      }
      .docs-layout {
        display: flex;
        min-height: 100vh;
      }
      .docs-sidebar {
        width: var(--docs-sidebar-width);
        padding: 2rem 1rem;
        border-inline-end: 1px solid #e5e7eb;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
        flex-shrink: 0;
      }
      .docs-sidebar h2 {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
      }
      .docs-sidebar a {
        display: block;
        padding: 0.25rem 0.5rem;
        color: #374151;
        text-decoration: none;
        font-size: 0.875rem;
        border-radius: 0.25rem;
      }
      .docs-sidebar a:hover {
        background: #f3f4f6;
        color: #111827;
      }
      .docs-main {
        flex: 1;
        padding: 2rem 3rem;
        max-width: calc(var(--docs-max-width) - var(--docs-sidebar-width));
      }
      .docs-main h1 { font-size: 2rem; margin-bottom: 0.5rem; }
      .docs-main h2 { font-size: 1.5rem; margin-top: 2rem; margin-bottom: 0.75rem; border-bottom: 1px solid #e5e7eb; padding-bottom: 0.25rem; }
      .docs-main h3 { font-size: 1.125rem; margin-top: 1.5rem; margin-bottom: 0.5rem; }
      .docs-main p { margin-bottom: 1rem; }
      .docs-main code { font-family: var(--docs-font-mono); background: #f3f4f6; padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.875em; }
      .docs-main pre { background: #1e1e1e; color: #d4d4d4; padding: 1rem; border-radius: 0.5rem; overflow-x: auto; margin-bottom: 1rem; }
      .docs-main pre code { background: none; padding: 0; color: inherit; }
      .docs-main table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
      .docs-main th, .docs-main td { text-align: start; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e5e7eb; font-size: 0.875rem; }
      .docs-main th { font-weight: 600; background: #f9fafb; }
      .docs-main ul, .docs-main ol { margin-bottom: 1rem; padding-inline-start: 1.5rem; }
      .docs-main li { margin-bottom: 0.25rem; }
      .status-badge {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
      }
      .status-badge--stable { background: #d1fae5; color: #065f46; }
      .status-badge--beta { background: #fef3c7; color: #92400e; }
      .status-badge--deprecated { background: #fee2e2; color: #991b1b; }
    </style>
  </head>
  <body>
    <div class="docs-layout">
      <nav class="docs-sidebar">
        <a href="/" style="font-weight:700;font-size:1.125rem;margin-bottom:1rem;">Arch UI</a>

        <h2>Getting Started</h2>
        <a href="/getting-started/installation">Installation</a>
        <a href="/getting-started/theming">Theming</a>
        <a href="/getting-started/dark-mode">Dark Mode</a>
        <a href="/getting-started/rtl">RTL Support</a>
        <a href="/getting-started/agent-usage">Agent Usage</a>

        <h2>Foundations</h2>
        <a href="/foundations/tokens">Tokens</a>
        <a href="/foundations/color">Color</a>
        <a href="/foundations/typography">Typography</a>
        <a href="/foundations/spacing">Spacing</a>
        <a href="/foundations/motion">Motion</a>
        <a href="/foundations/icons">Icons</a>
        <a href="/foundations/grid">Grid</a>
        <a href="/foundations/accessibility">Accessibility</a>

        <h2>Components</h2>
        <a href="/components/status">Status Overview</a>

        <h2>Patterns</h2>
        <a href="/patterns/forms">Forms</a>
        <a href="/patterns/data-tables">Data Tables</a>
        <a href="/patterns/loading-states">Loading States</a>
        <a href="/patterns/empty-states">Empty States</a>
        <a href="/patterns/error-handling">Error Handling</a>
        <a href="/patterns/navigation">Navigation</a>

        <h2>Changelog</h2>
        <a href="/changelog">Changelog</a>
      </nav>
      <main class="docs-main">
        <slot />
      </main>
    </div>
  </body>
</html>
