{
  "name": "arch-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Arch Design System — monorepo root",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint . && pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "pnpm --filter @arch-ui/tokens run build",
    "changeset": "changeset"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0"
  }
}
