{
  "typography": {
    "family": {
      "sans": { "$value": "'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace", "$type": "fontFamily" },
      "serif": { "$value": "Georgia, Cambria, 'Times New Roman', Times, serif", "$type": "fontFamily" }
    },
    "size": {
      "11": { "$value": "11px", "$type": "dimension" },
      "12": { "$value": "12px", "$type": "dimension" },
      "13": { "$value": "13px", "$type": "dimension" },
      "14": { "$value": "14px", "$type": "dimension" },
      "15": { "$value": "15px", "$type": "dimension" },
      "16": { "$value": "16px", "$type": "dimension" },
      "18": { "$value": "18px", "$type": "dimension" },
      "20": { "$value": "20px", "$type": "dimension" },
      "24": { "$value": "24px", "$type": "dimension" },
      "28": { "$value": "28px", "$type": "dimension" },
      "32": { "$value": "32px", "$type": "dimension" },
      "36": { "$value": "36px", "$type": "dimension" },
      "40": { "$value": "40px", "$type": "dimension" },
      "48": { "$value": "48px", "$type": "dimension" },
      "56": { "$value": "56px", "$type": "dimension" },
      "64": { "$value": "64px", "$type": "dimension" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" },
      "extrabold": { "$value": "800", "$type": "fontWeight" }
    },
    "line-height": {
      "none": { "$value": "1", "$type": "number" },
      "tight": { "$value": "1.2", "$type": "number" },
      "snug": { "$value": "1.375", "$type": "number" },
      "normal": { "$value": "1.5", "$type": "number" },
      "relaxed": { "$value": "1.625", "$type": "number" },
      "loose": { "$value": "2", "$type": "number" }
    },
    "letter-spacing": {
      "tighter": { "$value": "-0.05em", "$type": "dimension" },
      "tight": { "$value": "-0.025em", "$type": "dimension" },
      "normal": { "$value": "0em", "$type": "dimension" },
      "wide": { "$value": "0.025em", "$type": "dimension" },
      "wider": { "$value": "0.05em", "$type": "dimension" }
    }
  }
}
