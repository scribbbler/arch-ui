{
  "shadow": {
    "xs": { "$value": "0 1px 2px 0 rgba(0, 0, 0, 0.05)", "$type": "shadow" },
    "sm": { "$value": "0 1px 4px hsla(0, 0%, 0%, 0.16)", "$type": "shadow" },
    "md": { "$value": "0 2px 8px hsla(0, 0%, 0%, 0.16)", "$type": "shadow" },
    "lg": { "$value": "0 4px 16px hsla(0, 0%, 0%, 0.16)", "$type": "shadow" },
    "xl": { "$value": "0 8px 24px hsla(0, 0%, 0%, 0.16)", "$type": "shadow" },
    "2xl": { "$value": "0 16px 48px hsla(0, 0%, 0%, 0.22)", "$type": "shadow" },
    "inner": { "$value": "inset 0 2px 4px 0 rgba(0, 0, 0, 0.05)", "$type": "shadow" },
    "shallow-above": { "$value": "0px -4px 16px rgba(0, 0, 0, 0.12)", "$type": "shadow" },
    "shallow-below": { "$value": "0px 4px 16px rgba(0, 0, 0, 0.12)", "$type": "shadow" },
    "deep-above": { "$value": "0px -16px 48px rgba(0, 0, 0, 0.22)", "$type": "shadow" },
    "deep-below": { "$value": "0px 16px 48px rgba(0, 0, 0, 0.22)", "$type": "shadow" }
  }
}
