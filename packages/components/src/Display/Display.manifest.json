{
  "name": "Display",
  "description": "Large display text for hero sections, marketing pages, and visual emphasis. Not a semantic heading — use Heading for document structure. Display is purely visual.",
  "category": "typography",
  "status": "stable",
  "version": "0.1.0",
  "props": {
    "size": {
      "type": "'large' | 'medium' | 'small' | 'xsmall'",
      "description": "Typography scale size",
      "required": false,
      "default": "large"
    },
    "weight": {
      "type": "'semibold' | 'bold' | 'extrabold'",
      "description": "Font weight",
      "required": false,
      "default": "bold"
    },
    "color": {
      "type": "string",
      "description": "Semantic text color token name",
      "required": false,
      "default": "color-text-default"
    },
    "as": {
      "type": "React.ElementType",
      "description": "HTML element to render. Default: 'p'. Use Heading for semantic h1-h6.",
      "required": false,
      "default": "p"
    },
    "children": { "type": "React.ReactNode", "required": true }
  },
  "usage": {
    "do": [
      "Use Display for hero text, marketing headlines, and large visual emphasis",
      "Pair with Heading when you need both visual size and semantic heading level"
    ],
    "doNot": [
      "Do not use Display for document headings — use Heading for h1-h6 semantics",
      "Do not use Display for body text — use Paragraph"
    ]
  },
  "tokens": {
    "used": [
      "typography-scale-display-large-font-size",
      "typography-scale-display-large-line-height",
      "typography-scale-display-large-letter-spacing",
      "typography-scale-display-medium-font-size",
      "typography-scale-display-medium-line-height",
      "typography-scale-display-medium-letter-spacing",
      "typography-scale-display-small-font-size",
      "typography-scale-display-small-line-height",
      "typography-scale-display-small-letter-spacing",
      "typography-scale-display-xsmall-font-size",
      "typography-scale-display-xsmall-line-height",
      "typography-scale-display-xsmall-letter-spacing",
      "typography-weight-semibold",
      "typography-weight-bold",
      "typography-weight-extrabold",
      "color-text-default",
      "typography-family-sans"
    ]
  }
}
