{
  "name": "Label",
  "description": "UI text for interactive elements — form labels, button text, navigation items, badges, table headers. Medium or semibold weight by default. Not for body copy (use Paragraph) or headings (use Heading).",
  "category": "typography",
  "status": "stable",
  "version": "0.1.0",
  "props": {
    "size": {
      "type": "'large' | 'medium' | 'small' | 'xsmall'",
      "description": "Label size. Maps to label scale tokens.",
      "required": false,
      "default": "medium"
    },
    "weight": {
      "type": "'medium' | 'semibold' | 'bold'",
      "description": "Font weight. Default: 'medium'.",
      "required": false,
      "default": "medium"
    },
    "color": {
      "type": "string",
      "description": "Semantic text color token name",
      "required": false,
      "default": "color-text-default"
    },
    "uppercase": {
      "type": "boolean",
      "description": "Renders text in uppercase with wider letter-spacing. Useful for overlines and category labels.",
      "required": false,
      "default": false
    },
    "as": {
      "type": "React.ElementType",
      "description": "HTML element to render. Default: 'span'.",
      "required": false,
      "default": "span"
    },
    "children": { "type": "React.ReactNode", "required": true }
  },
  "usage": {
    "do": [
      "Use Label for button text, nav items, form labels, table headers, badge text",
      "Use uppercase=true for overlines and category labels",
      "Use size='xsmall' for fine print and metadata"
    ],
    "doNot": [
      "Do not use Label for body copy — use Paragraph",
      "Do not use Label for page headings — use Heading or Display"
    ]
  },
  "tokens": {
    "used": [
      "typography-scale-label-large-font-size",
      "typography-scale-label-large-line-height",
      "typography-scale-label-large-letter-spacing",
      "typography-scale-label-medium-font-size",
      "typography-scale-label-medium-line-height",
      "typography-scale-label-medium-letter-spacing",
      "typography-scale-label-small-font-size",
      "typography-scale-label-small-line-height",
      "typography-scale-label-small-letter-spacing",
      "typography-scale-label-xsmall-font-size",
      "typography-scale-label-xsmall-line-height",
      "typography-scale-label-xsmall-letter-spacing",
      "typography-weight-medium",
      "typography-weight-semibold",
      "typography-weight-bold",
      "color-text-default",
      "typography-family-sans",
      "typography-letter-spacing-wider"
    ]
  }
}
