{
  "name": "Paragraph",
  "description": "Body text for content paragraphs, descriptions, and long-form reading. Regular weight by default. Optimized for readability.",
  "category": "typography",
  "status": "stable",
  "version": "0.1.0",
  "props": {
    "size": {
      "type": "'large' | 'medium' | 'small' | 'xsmall'",
      "description": "Paragraph size. Maps to paragraph scale tokens.",
      "required": false,
      "default": "medium"
    },
    "weight": {
      "type": "'regular' | 'medium'",
      "description": "Font weight. Default: 'regular'.",
      "required": false,
      "default": "regular"
    },
    "color": {
      "type": "string",
      "description": "Semantic text color token name",
      "required": false,
      "default": "color-text-default"
    },
    "truncate": {
      "type": "boolean",
      "description": "Truncate with ellipsis on a single line",
      "required": false,
      "default": false
    },
    "as": {
      "type": "React.ElementType",
      "description": "HTML element to render. Default: 'p'.",
      "required": false,
      "default": "p"
    },
    "children": { "type": "React.ReactNode", "required": true }
  },
  "usage": {
    "do": [
      "Use Paragraph for body text, descriptions, and content blocks",
      "Use size='small' for secondary text and captions",
      "Use color='color-text-subtle' for secondary content"
    ],
    "doNot": [
      "Do not use Paragraph for UI labels — use Label",
      "Do not use Paragraph for headings — use Heading or Display"
    ]
  },
  "tokens": {
    "used": [
      "typography-scale-paragraph-large-font-size",
      "typography-scale-paragraph-large-line-height",
      "typography-scale-paragraph-large-letter-spacing",
      "typography-scale-paragraph-medium-font-size",
      "typography-scale-paragraph-medium-line-height",
      "typography-scale-paragraph-medium-letter-spacing",
      "typography-scale-paragraph-small-font-size",
      "typography-scale-paragraph-small-line-height",
      "typography-scale-paragraph-small-letter-spacing",
      "typography-scale-paragraph-xsmall-font-size",
      "typography-scale-paragraph-xsmall-line-height",
      "typography-scale-paragraph-xsmall-letter-spacing",
      "typography-weight-regular",
      "typography-weight-medium",
      "color-text-default",
      "typography-family-sans"
    ]
  }
}
